{
  "name": "themeetloop_backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test src/modules/meetings/meetingValidationSchemas.test.ts src/modules/meeting-processing/deterministicActionableNotesProvider.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "auth:migrate": "pnpm dlx auth@latest migrate --config src/modules/authentication/authenticationConfiguration.ts",
    "auth:generate": "pnpm dlx auth@latest generate --config src/modules/authentication/authenticationConfiguration.ts",
    "database:migrate": "tsx src/infrastructure/database/runDatabaseMigrations.ts"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "better-auth": "^1.7.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "resend": "^6.25.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
